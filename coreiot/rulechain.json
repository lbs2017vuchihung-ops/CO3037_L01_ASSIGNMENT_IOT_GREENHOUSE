        },
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "var soilMoisture = msg.soilMoisture;\nvar soilThreshold = Number(metadata.shared_soil_threshold);\n\nvar desiredPumpState = soilMoisture < soilThreshold;\n\nvar rpcMsg = {\n    method: \"setPump\",\n    params: desiredPumpState\n};\n\nreturn {\n    msg: rpcMsg,\n    metadata: metadata,\n    msgType: msgType\n};",
          "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
        },
        "additionalInfo": {
          "description": "",
