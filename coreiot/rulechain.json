      {
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "Check Pump State",
        "debugSettings": {
          "failuresEnabled": false,
          "allEnabled": false,
          "allEnabledUntil": 1795706384099
        },
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "var soilMoisture = msg.soilMoisture;\nvar soilThreshold = Number(metadata.shared_soil_threshold);\nvar pumpState = msg.pumpState;\n\nif (typeof soilMoisture !== \"number\" ||\n    typeof pumpState !== \"boolean\" ||\n    !isFinite(soilMoisture) ||\n    !isFinite(soilThreshold)) {\n    return false;\n}\n\nvar desiredPumpState = soilMoisture < soilThreshold;\n\nreturn pumpState !== desiredPumpState;",
          "tbelScript": "var soilMoisture = msg.soilMoisture;\nvar soilThreshold = Number(metadata.shared_soil_threshold);\nvar pumpState = msg.pumpState;\n\nif (typeof soilMoisture !== \"number\" ||\n    typeof pumpState !== \"boolean\" ||\n    !isFinite(soilMoisture) ||\n    !isFinite(soilThreshold)) {\n    return false;\n}\n\nvar desiredPumpState = soilMoisture < soilThreshold;\n\nreturn pumpState !== desiredPumpState;"
        },
        "additionalInfo": {
          "description": "",
          "layoutX": 693,
          "layoutY": 417
        }
      },
      {
        "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
        "name": "Check Fan State",
        "debugSettings": {
          "failuresEnabled": false,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "var airTemp = msg.airTemp;\nvar tempThreshold = Number(metadata.shared_temp_threshold);\nvar fanState = msg.fanState;\n\nif (typeof airTemp !== \"number\" ||\n    typeof fanState !== \"boolean\" ||\n    !isFinite(airTemp) ||\n    !isFinite(tempThreshold)) {\n    return false;\n}\n\nvar desiredFanState = airTemp > tempThreshold;\n\nreturn fanState !== desiredFanState;",
          "tbelScript": "return msg.temperature > 20;"
        },
        "additionalInfo": {
          "description": "",
          "layoutX": 1072,
          "layoutY": 418
        }
